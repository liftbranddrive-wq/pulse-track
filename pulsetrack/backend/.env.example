NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsetrack

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ADMIN_PANEL_ORIGIN=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Optional: comma-separated origins (overrides loose CORS when all set)
ALLOWED_ORIGINS=http://localhost:5173

# Redis for Bull queue (omit to use synchronous email fallback + in-memory dup guard)
REDIS_URL=redis://127.0.0.1:6379

# SendGrid alternative (leave empty when using SMTP in Org Settings)
SENDGRID_DEFAULT_KEY=
