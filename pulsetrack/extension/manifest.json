{
  "manifest_version": 3,
  "name": "Liftbrand PulseTrack",
  "description": "Liftbrand team time tracking — clock in, breaks, and activity insights.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Liftbrand PulseTrack",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms", "notifications", "idle"],
  "host_permissions": ["http://localhost:4000/*", "http://127.0.0.1:4000/*", "https://*/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/activity-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
